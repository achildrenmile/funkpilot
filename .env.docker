# FunkPilot Docker Environment Variables
# Copy this file to .env and fill in your API keys

# Anthropic Claude API Key (recommended for best quality)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter API Key (alternative, has free models)
# Get yours at: https://openrouter.ai/keys
# Free models available: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=

# Note: At least one API key is required for AI features to work
# If both are set, Anthropic will be used first
