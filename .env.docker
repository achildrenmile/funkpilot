# FunkPilot Docker Environment Variables
# Copy this file to .env and fill in your API keys

# Groq API Key (EMPFOHLEN - kostenlos, schnell, mit Ham Radio Tools)
# Unterstützt MCP Tools für Amateur Radio Berechnungen
# Key erstellen: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude API Key (beste Qualität, kostenpflichtig)
# Key erstellen: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter API Key (Fallback, viele Modelle)
# Key erstellen: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Note: At least one API key is required for AI features to work
# Priority: Groq (with MCP tools) -> Anthropic -> OpenRouter
