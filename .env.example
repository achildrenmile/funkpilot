# FunkPilot Environment Variables
# At least one AI provider API key is required

# Groq API Key (EMPFOHLEN - kostenlos, schnell)
# Unterstützt MCP Tools für Amateur Radio Berechnungen
# Key erstellen: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Anthropic Claude API Key (beste Qualität, kostenpflichtig)
# Key erstellen: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenRouter API Key (Fallback, viele Modelle)
# Key erstellen: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_key_here
